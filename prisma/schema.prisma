// Jogajog Emergency — data model
// Physical QR-sticker store + SaaS emergency-profile platform.
// See docs/superpowers/specs/2026-09-02-jogajog-emergency-redesign-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TagStatus {
  ACTIVE
  LOST
  DEACTIVATED
}

enum ContactMode {
  RELAY // finder sends a message through the platform; phone/email never shown
  DIRECT_CALL // click-to-call a public/forwarding number the owner set
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum PaymentProvider {
  DEMO
  SSLCOMMERZ
  BKASH
  NAGAD
  STRIPE
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  PENDING
  CANCELLED
}

enum PaymentKind {
  ORDER
  SUBSCRIPTION
}

enum AbuseReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
}

enum VisibilityPreset {
  MINIMAL
  STANDARD
  FULL
  CUSTOM
}

enum MediaKind {
  PROFILE_PHOTO
  PRODUCT_IMAGE
  THEME_ART
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  emailVerified     DateTime?
  phone             String?
  passwordHash      String
  role              Role       @default(USER)
  status            UserStatus @default(ACTIVE)
  // Sessions are JWTs and cannot be deleted server-side. Stamping this on a
  // password reset lets requireActiveUser reject tokens minted before it.
  passwordChangedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tags             Tag[]
  subscriptions    Subscription[]
  sessions         Session[]
  accounts         Account[]
  abuseReports     AbuseReport[]     @relation("ReportedBy")
  emergencyProfile EmergencyProfile?
  orders           Order[]
  mediaAssets      MediaAsset[]      @relation("MediaOwner")

  @@index([email])
}

// Auth.js database session/account tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Plus tier ------------------------------------------------------------
// Unlocks the portfolio layer, premium themes and full scan history. It never
// gates emergency information — see src/lib/entitlements.ts.

model SubscriptionPlan {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  priceCents Int
  currency   String   @default("BDT")
  features   String[]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  provider         PaymentProvider    @default(DEMO)
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
}

// --- Physical product store ----------------------------------------------

// A theme spans two surfaces: the artwork printed on a sticker (via Product)
// and the skin the scan page renders in (via Tag). Deliberately
// character-agnostic — a theme is a name, a palette, a mascot key and an
// artwork asset, so no third-party character is referenced in code or seed
// data. Licensed characters, if ever licensed, are added as rows.
model Theme {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  tagline String

  // Scan-page skin tokens. Explicit columns rather than a JSON blob so the
  // admin form and the renderer share one typed contract, and a malformed
  // theme cannot reach the scan page.
  bgColor      String @default("#FBF9F6")
  surfaceColor String @default("#FFFFFF")
  inkColor     String @default("#171717")
  accentColor  String @default("#059669")

  mascot     String        @default("BLOB")
  artAssetId String?
  status     ProductStatus @default(ACTIVE)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  artAsset MediaAsset? @relation("ThemeArt", fields: [artAssetId], references: [id])
  products Product[]
  tags     Tag[]

  @@index([status, sortOrder])
}

model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  tagline      String
  description  String
  useCase      String?
  priceCents   Int
  currency     String        @default("BDT")
  // How many QR codes this purchase entitles the buyer to generate.
  qrSlots      Int           @default(1)
  imageAssetId String?
  themeId      String?
  status       ProductStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  imageAsset MediaAsset? @relation("ProductImage", fields: [imageAssetId], references: [id])
  theme      Theme?      @relation(fields: [themeId], references: [id])
  tags       Tag[]
  orderItems OrderItem[]

  @@index([status, sortOrder])
}

model Order {
  id                   String            @id @default(cuid())
  orderNumber          String            @unique
  // Per-checkout-form token. The unique index is what makes a double-submit
  // return the original order instead of placing a second one.
  idempotencyKey       String?           @unique
  userId               String
  status               OrderStatus       @default(PENDING)
  fulfillmentStatus    FulfillmentStatus @default(UNFULFILLED)
  subtotalCents        Int
  totalCents           Int
  currency             String            @default("BDT")
  shipName             String?
  shipPhone            String?
  shipAddress          String?
  shipCity             String?
  shipNote             String?
  placedAt             DateTime?
  // Tags are reserved when the order is created and released again if the
  // customer never comes back from the gateway.
  reservationExpiresAt DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int    @default(1)
  unitPriceCents Int
  currency       String @default("BDT")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  tags    Tag[]

  @@index([orderId])
}

// A Payment row is created *before* the customer leaves for the gateway, and
// its own id is the merchant transaction reference we hand over. The callback
// therefore identifies the payment without trusting anything else in the
// payload — see src/lib/payments/settle.ts.
model Payment {
  id               String          @id @default(cuid())
  kind             PaymentKind     @default(ORDER)
  orderId          String?
  subscriptionId   String?
  amountCents      Int
  currency         String          @default("BDT")
  provider         PaymentProvider @default(DEMO)
  // The provider's own transaction id, known only once it settles.
  providerRef      String?
  // The provider's handle for the in-flight payment (bKash paymentID, Nagad
  // paymentReferenceId, SSLCommerz sessionkey), needed to verify or execute it.
  gatewayPaymentId String?
  status           PaymentStatus   @default(PENDING)
  failureReason    String?
  settledAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([subscriptionId])
  @@index([gatewayPaymentId])
  @@index([status, createdAt])
}

// --- Physical QR tags --------------------------------------------------

model Tag {
  id            String    @id @default(cuid())
  shortCode     String    @unique
  // Every tag is created by its owner from the client area, against a QR slot
  // a sticker purchase paid for. There is no unowned inventory.
  userId        String
  // Which purchase paid for this tag's slot, kept for provenance only.
  orderItemId   String?
  productId     String?
  themeId       String?
  internalLabel String?
  status        TagStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id])
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  theme         Theme?         @relation(fields: [themeId], references: [id])
  scanEvents    ScanEvent[]
  relayMessages RelayMessage[]
  abuseReports  AbuseReport[]

  @@index([userId])
  @@index([productId])
  @@index([orderItemId])
  @@index([status])
}

model ScanEvent {
  id            String   @id @default(cuid())
  tagId         String
  scannedAt     DateTime @default(now())
  ipHash        String // hashed IP, never store raw IP
  approxCity    String?
  approxRegion  String?
  approxCountry String?
  userAgent     String?

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId, scannedAt])
}

model RelayMessage {
  id            String    @id @default(cuid())
  tagId         String
  finderContact String // email or phone the finder left for a reply
  message       String
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId])
}

model AbuseReport {
  id           String            @id @default(cuid())
  tagId        String?
  reportedById String?
  reason       String
  details      String?
  status       AbuseReportStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  resolvedAt   DateTime?

  tag        Tag?  @relation(fields: [tagId], references: [id], onDelete: SetNull)
  reportedBy User? @relation("ReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([tagId])
}

// --- SaaS emergency profile -------------------------------------------

model EmergencyProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  displayName        String?
  photoAssetId       String?
  bloodGroup         String?
  allergies          String?
  medicalNotes       String?
  emergencyMessage   String?
  bio                String?
  contactMode        ContactMode      @default(RELAY)
  phonePublic        String?
  visibilityPreset   VisibilityPreset @default(STANDARD)
  photoPublic        Boolean          @default(true)
  namePublic         Boolean          @default(true)
  messagePublic      Boolean          @default(true)
  bloodGroupPublic   Boolean          @default(false)
  allergiesPublic    Boolean          @default(false)
  medicalNotesPublic Boolean          @default(false)
  contactsPublic     Boolean          @default(true)
  showPhone          Boolean          @default(false)
  bioPublic          Boolean          @default(false)
  linksPublic        Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoAsset MediaAsset?        @relation("ProfilePhoto", fields: [photoAssetId], references: [id])
  contacts   EmergencyContact[]
  links      ProfileLink[]
}

// The portfolio layer: what a scan shows beyond the emergency essentials.
// Subscription-gated — see src/lib/entitlements.ts.
model ProfileLink {
  id        String  @id @default(cuid())
  profileId String
  label     String
  url       String
  sortOrder Int     @default(0)
  isPublic  Boolean @default(true)

  profile EmergencyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model EmergencyContact {
  id        String  @id @default(cuid())
  profileId String
  name      String
  relation  String?
  phone     String?
  email     String?
  isPublic  Boolean @default(true)
  sortOrder Int     @default(0)

  profile EmergencyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model MediaAsset {
  id        String    @id @default(cuid())
  ownerId   String?
  kind      MediaKind
  mimeType  String
  byteSize  Int
  width     Int?
  height    Int?
  data      Bytes
  checksum  String
  createdAt DateTime  @default(now())

  owner         User?              @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  profileUsages EmergencyProfile[] @relation("ProfilePhoto")
  productUsages Product[]          @relation("ProductImage")
  themeUsages   Theme[]            @relation("ThemeArt")

  @@index([ownerId])
}
