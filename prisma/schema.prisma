// Jogajog Emergency — data model
// Physical QR-sticker store + SaaS emergency-profile platform.
// See docs/superpowers/specs/2026-09-02-jogajog-emergency-redesign-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TagStatus {
  UNASSIGNED // raw inventory, no owner
  ALLOCATED // attached to an order, not yet activated
  ACTIVE
  LOST
  DEACTIVATED
}

enum ContactMode {
  RELAY // finder sends a message through the platform; phone/email never shown
  DIRECT_CALL // click-to-call a public/forwarding number the owner set
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum PaymentProvider {
  DEMO
  SSLCOMMERZ
  BKASH
  STRIPE
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  PENDING
}

enum PaymentKind {
  ORDER
  SUBSCRIPTION
}

enum AbuseReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
}

enum VisibilityPreset {
  MINIMAL
  STANDARD
  FULL
  CUSTOM
}

enum MediaKind {
  PROFILE_PHOTO
  PRODUCT_IMAGE
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  emailVerified     DateTime?
  phone             String?
  passwordHash      String
  role              Role       @default(USER)
  status            UserStatus @default(ACTIVE)
  // Sessions are JWTs and cannot be deleted server-side. Stamping this on a
  // password reset lets requireActiveUser reject tokens minted before it.
  passwordChangedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tags             Tag[]
  subscriptions    Subscription[]
  sessions         Session[]
  accounts         Account[]
  abuseReports     AbuseReport[]     @relation("ReportedBy")
  emergencyProfile EmergencyProfile?
  orders           Order[]
  mediaAssets      MediaAsset[]      @relation("MediaOwner")
  tagBatches       TagBatch[]

  @@index([email])
}

// Auth.js database session/account tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Optional premium tier (dormant; gated by PREMIUM_ENABLED) -------------

model SubscriptionPlan {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  priceCents Int
  currency   String   @default("BDT")
  maxTags    Int
  features   String[]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  provider         PaymentProvider    @default(DEMO)
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
}

// --- Physical product store ----------------------------------------------

model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  tagline      String
  description  String
  useCase      String?
  priceCents   Int
  currency     String        @default("BDT")
  imageAssetId String?
  status       ProductStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  imageAsset MediaAsset? @relation("ProductImage", fields: [imageAssetId], references: [id])
  tags       Tag[]
  orderItems OrderItem[]
  batches    TagBatch[]

  @@index([status, sortOrder])
}

model TagBatch {
  id          String   @id @default(cuid())
  label       String
  productId   String?
  quantity    Int
  createdById String
  createdAt   DateTime @default(now())

  product   Product? @relation(fields: [productId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])
  tags      Tag[]

  @@index([productId])
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  // Per-checkout-form token. The unique index is what makes a double-submit
  // return the original order instead of placing a second one.
  idempotencyKey    String?           @unique
  userId            String
  status            OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  subtotalCents     Int
  totalCents        Int
  currency          String            @default("BDT")
  shipName          String?
  shipPhone         String?
  shipAddress       String?
  shipCity          String?
  shipNote          String?
  placedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int    @default(1)
  unitPriceCents Int
  currency       String @default("BDT")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  tags    Tag[]

  @@index([orderId])
}

model Payment {
  id             String          @id @default(cuid())
  kind           PaymentKind     @default(ORDER)
  orderId        String?
  subscriptionId String?
  amountCents    Int
  currency       String          @default("BDT")
  provider       PaymentProvider @default(DEMO)
  providerRef    String?
  status         PaymentStatus   @default(PENDING)
  createdAt      DateTime        @default(now())

  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([subscriptionId])
}

// --- Physical QR tags --------------------------------------------------

model Tag {
  id            String    @id @default(cuid())
  shortCode     String    @unique
  claimCode     String    @unique
  productId     String?
  batchId       String?
  orderItemId   String?
  userId        String?
  internalLabel String?
  status        TagStatus @default(UNASSIGNED)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product       Product?       @relation(fields: [productId], references: [id])
  batch         TagBatch?      @relation(fields: [batchId], references: [id])
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  scanEvents    ScanEvent[]
  relayMessages RelayMessage[]
  abuseReports  AbuseReport[]

  @@index([userId])
  @@index([productId])
  @@index([orderItemId])
  @@index([status])
}

model ScanEvent {
  id            String   @id @default(cuid())
  tagId         String
  scannedAt     DateTime @default(now())
  ipHash        String // hashed IP, never store raw IP
  approxCity    String?
  approxRegion  String?
  approxCountry String?
  userAgent     String?

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId, scannedAt])
}

model RelayMessage {
  id            String    @id @default(cuid())
  tagId         String
  finderContact String // email or phone the finder left for a reply
  message       String
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId])
}

model AbuseReport {
  id           String            @id @default(cuid())
  tagId        String?
  reportedById String?
  reason       String
  details      String?
  status       AbuseReportStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  resolvedAt   DateTime?

  tag        Tag?  @relation(fields: [tagId], references: [id], onDelete: SetNull)
  reportedBy User? @relation("ReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([tagId])
}

// --- SaaS emergency profile -------------------------------------------

model EmergencyProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  displayName        String?
  photoAssetId       String?
  bloodGroup         String?
  allergies          String?
  medicalNotes       String?
  emergencyMessage   String?
  contactMode        ContactMode      @default(RELAY)
  phonePublic        String?
  visibilityPreset   VisibilityPreset @default(STANDARD)
  photoPublic        Boolean          @default(true)
  namePublic         Boolean          @default(true)
  messagePublic      Boolean          @default(true)
  bloodGroupPublic   Boolean          @default(false)
  allergiesPublic    Boolean          @default(false)
  medicalNotesPublic Boolean          @default(false)
  contactsPublic     Boolean          @default(true)
  showPhone          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoAsset MediaAsset?        @relation("ProfilePhoto", fields: [photoAssetId], references: [id])
  contacts   EmergencyContact[]
}

model EmergencyContact {
  id        String  @id @default(cuid())
  profileId String
  name      String
  relation  String?
  phone     String?
  email     String?
  isPublic  Boolean @default(true)
  sortOrder Int     @default(0)

  profile EmergencyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model MediaAsset {
  id        String    @id @default(cuid())
  ownerId   String?
  kind      MediaKind
  mimeType  String
  byteSize  Int
  width     Int?
  height    Int?
  data      Bytes
  checksum  String
  createdAt DateTime  @default(now())

  owner         User?              @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  profileUsages EmergencyProfile[] @relation("ProfilePhoto")
  productUsages Product[]          @relation("ProductImage")

  @@index([ownerId])
}
