# --- Core ------------------------------------------------------------------
DATABASE_URL="postgresql://jogajog:jogajog@localhost:5432/jogajog_emergency?schema=public"

# Auth.js JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Salt for hashing scanner IPs (src/lib/hash.ts). Any long random string.
IP_HASH_SALT=""

# The seeded first admin. Leave the password blank and `npm run db:seed` prints
# a generated one once — nothing here ships a known credential.
SEED_ADMIN_EMAIL="admin@jogajog.app"
SEED_ADMIN_PASSWORD=""

# --- Payments --------------------------------------------------------------
# "sandbox" (default) or "live". In live mode the DEMO provider is refused
# outright, so a real deployment cannot accidentally hand out free orders.
PAYMENT_MODE="sandbox"

# Set to 0 to hide the DEMO provider even in sandbox mode.
PAYMENT_ALLOW_DEMO="1"

# A provider whose variables are blank is simply not offered at checkout, so
# you can enable one, two or all three.

# bKash tokenized checkout (https://developer.bka.sh)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# Nagad. The two keys are RSA keys issued during merchant onboarding; either a
# full PEM or the bare base64 body works.
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_NUMBER=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""

# SSLCommerz (https://developer.sslcommerz.com)
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""

# --- Email -----------------------------------------------------------------
# Without these the app runs fine and prints what it would have sent, but
# nothing reaches anyone — including messages finders leave for owners.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Jogajog Emergency <no-reply@jogajog.app>"

# --- Operations ------------------------------------------------------------
# How many proxies sit in front of this app (nginx, Cloudflare, a load
# balancer). The caller's address is counted back that many hops from the end
# of X-Forwarded-For, so a caller cannot invent one: everything to the left of
# what your own proxy appended is unverified, and trusting it would let anyone
# reset their own login, signup, relay, abuse and scan rate limits per request.
# Set 0 when nothing is in front of the app — forwarding headers are then
# ignored entirely (all traffic shares one bucket).
TRUSTED_PROXY_HOPS="1"

# "postgres" shares rate-limit budgets across instances. Leave unset for a
# single-process deployment, where the in-memory limiter is exact and free.
RATE_LIMIT_STORE=""

# Bearer token for /api/maintenance (expiry warnings, pruning). Without it the
# endpoint 404s. Generate with: openssl rand -hex 32
MAINTENANCE_SECRET=""

# --- A note on NEXT_PUBLIC_APP_URL ----------------------------------------
# It must match the origin the app is actually served from. QR codes and
# payment callback URLs are built from it, so if another process holds the
# port it names, callbacks reach that process instead and payments are taken
# but never settled. The server warns at startup and before each payment when
# the two disagree; in production a mismatch or a localhost value refuses to
# boot (src/lib/env.ts).
